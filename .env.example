# ============================================
# FoodFlow2026 — แม่แบบตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env เด็ดขาด)
# ============================================

# SQLite สำหรับ Prisma (เศษเทมเพลต — แอปหลักใช้ Supabase ผ่าน REST)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret — สุ่มสตริงยาวอย่างน้อย 48 ตัวอักษร
# สร้าง: openssl rand -hex 32
SESSION_SECRET=<สุ่มสตริงยาว 48+ ตัวอักษร>

# Supabase (Postgres + PostGIS ของระบบจริง)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — ใช้เฉพาะฝั่ง server ห้ามหลุดสู่ client>
SUPABASE_ANON_KEY=<anon key>

# ตัวแปรเสริมของสคริปต์ seed (ใช้ตอนรัน scripts/seed-*.mjs)
# SBK=<service_role key>

# ช่องทางรหัสยืนยัน — จบในระบบ: รหัสแสดงในแอป (ค่าเริ่มต้น) ไม่ส่ง SMS
VERIFICATION_DELIVERY=internal_code

# คีย์สาธารณะสำหรับ Realtime และแผนที่ PMTiles (ฝั่ง client)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_CALLS_ENABLED=false
NEXT_PUBLIC_MAP_PMTILES_URL=
