# ================= FoodFlow2026 — .gitignore =================
# มาตรฐาน: ห้ามมีไฟล์ลับ / ไฟล์ runtime / ไฟล์ส่วนตัวเข้า repository โดยเด็ดขาด

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / coverage
/coverage
# next.js build output
/.next/
/out/
/build

# ---- SECRETS (ห้าม commit โดยเด็ดขาด — ใช้ .env.example เป็นแม่แบบแทน) ----
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
.dev.vars

# ---- DATABASE / RUNTIME DATA (ไม่เข้า repo — ใช้ scripts/seed-*.mjs แทน) ----
/db/
*.db
*.db-journal
*.sqlite

# ---- ไฟล์ runtime / sandbox ----
*.log
dev.log
dev.out.log
server.log
tool-results/
agent-ctx/
.zscripts/
.claude
.z-ai-config
/skills/
local-*
prompt
test

# ---- ไฟล์อัปโหลดส่วนตัว ----
/upload/
/download/

# misc
.DS_Store
Thumbs.db

# debug logs ของ package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# แม่แบบต้นทาง (โคลน JasonTM17/FoodDelivery_App) — เก็บไว้เทียบ/ดึงอัพเดทต้นทาง แต่ไม่ commit ลง repo นี้
/_template-ref/

# ผลจาก npm install (โปรเจกต์มาตรฐานใช้ Bun — มี bun.lock เป็นหลัก)
/package-lock.json
